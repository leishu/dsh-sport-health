{
  "name": "dsh-sport-health",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: Vue 3 + Element Plus + ECharts UI for the sport-health MCP server",
  "license": "MIT",
  "author": "leishu",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mcp",
    "sport-health",
    "running",
    "vue3",
    "echarts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leishu/dsh-sport-health.git"
  },
  "homepage": "https://github.com/leishu/dsh-sport-health#readme",
  "bugs": {
    "url": "https://github.com/leishu/dsh-sport-health/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "vite build && vite build --mode host",
    "dev": "vite build --watch & vite build --mode host --watch",
    "preview": "node preview/serve.mjs",
    "test": "vite build && node tests/render.mjs && node tests/host.mjs",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "npm run test && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.0",
    "vite": "^7.3.7",
    "vue": "^3.4.0",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "dsh": ">=0.2.0 <0.3.0"
  }
}
